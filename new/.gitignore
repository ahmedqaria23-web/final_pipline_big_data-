# ==========================================
# Big Data Midterm Pipeline - .gitignore
# ==========================================

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Environment variables & secrets
.env
config/.env
*.env.local
*.env.*.local

# IDE & Editor files
.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/

# Test artifacts & caches
.pytest_cache/
.coverage
htmlcov/
*.coveragerc

# Large dataset files (do not commit raw CSV > 10MB)
data/*.csv
data/*.jsonl
data/*.json
!data/.gitkeep
!data/sample_*.csv
!data/sample_*.jsonl
new_data/*.csv
!new_data/test_*.csv


# MongoDB data files
*.bson
*.ns
mongod.lock
dump/

# Log files (pipeline.log can be very large)
reports/pipeline.log
*.log

# Temporary / scratch files
check_results.py
*.tmp
*.bak
*.swp
*.swo

# Spark temporary output
spark-warehouse/
derby.log
metastore_db/
__spark_metadata/

# Windows junction links (created by settings.py for ASCII path compatibility)
# These are managed at runtime, not committed
# C:/jdk17 -> managed externally
# C:/pyspark_home -> managed externally

# Byte-order mark files
*.bom

# Large compiled Java files
*.jar
*.class

# Archive files  
*.zip
*.tar.gz
*.tar.bz2
*.7z
*.rar
